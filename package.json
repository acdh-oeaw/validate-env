{
	"name": "@acdh-oeaw/validate-env",
	"version": "0.3.0",
	"license": "MIT",
	"repository": {
		"url": "https://github.com/acdh-oeaw/validate-env"
	},
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./astro": "./dist/astro.js",
		"./next": "./dist/next.js",
		"./runtime": "./dist/runtime.js"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": "^22 || ^24 || ^26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"build": "tsdown",
		"changeset:add": "changeset add",
		"changeset:status": "changeset status --verbose",
		"ci:release": "changeset publish",
		"ci:version": "changeset version && oxfmt \"**/CHANGELOG.md\"",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint:check": "oxlint --type-aware",
		"lint:fix": "pnpm run lint:check --fix",
		"prepare": "run-s setup",
		"prepublishOnly": "run-s validate build",
		"setup": "is-ci || simple-git-hooks",
		"test": "uvu -r tsm",
		"types:check": "tsc --noEmit",
		"validate": "run-p format:check lint:check types:check test"
	},
	"peerDependencies": {
		"typescript": ">=5.4"
	},
	"devDependencies": {
		"@acdh-oeaw/commitlint-config": "^3.0.0",
		"@acdh-oeaw/tsconfig-lib": "^1.3.0",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.4",
		"is-ci": "^4.1.0",
		"lint-staged": "^17.6.1",
		"npm-run-all2": "^9.0.4",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"simple-git-hooks": "^2.14.0",
		"tsdown": "^0.23.7",
		"tsm": "^2.3.0",
		"typescript": "^7.0.2",
		"uvu": "^0.5.6",
		"valibot": "^1.5.0"
	},
	"commitlint": {
		"extends": "@acdh-oeaw/commitlint-config"
	},
	"lint-staged": {
		"*.ts": [
			"oxlint --type-aware --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"!(*.ts)": "oxfmt --no-error-on-unmatched-pattern"
	},
	"simple-git-hooks": {
		"commit-msg": "pnpm exec commitlint --edit",
		"pre-commit": "pnpm exec lint-staged",
		"pre-push": "pnpm run validate"
	}
}
